{
  "name": "mariobgsp-articles-tools",
  "private": true,
  "type": "module",
  "description": "Capture + diagram tooling for the project articles. Screenshots are taken from the real running applications, so the images in each article can be regenerated.",
  "scripts": {
    "diagrams": "python3 tools/render-diagrams.py",
    "capture:payment-system": "node tools/capture/payment-system.mjs",
    "capture:the-gateway": "node tools/capture/the-gateway.mjs",
    "capture:trading-suite": "node tools/capture/trading-suite.mjs",
    "capture:durable-agents": "node tools/capture/durable-agents.mjs",
    "capture:routre": "node tools/capture/routre.mjs",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint.json *.md"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.18.1",
    "playwright-core": "^1.56.0"
  }
}
